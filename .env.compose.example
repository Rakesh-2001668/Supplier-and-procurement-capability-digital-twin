# Copy to .env next to docker-compose.yml. Never commit the real file.
# Local PostgreSQL (profile local-db)
POSTGRES_USER=pic
POSTGRES_PASSWORD=
POSTGRES_DB=pic
# Leave DATABASE_URL empty to use the local db service, or set a hosted (staging) connection string with sslmode=require.
DATABASE_URL=
# dev (default for compose: legacy demo on, docs on, no rate limits) | staging | production (strict start-up checks)
PIC_ENV=dev
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
PIC_JWT_SECRET=
# Generate: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PIC_FIELD_KEY=
PIC_SEED_PASSWORD=
PIC_CORS_ORIGINS=
# Bearer token for GET /metrics (at least 24 characters)
PIC_METRICS_TOKEN=
# Optional overrides
# PIC_ENABLE_LEGACY_DEMO=false
# PIC_RATE_LIMIT_PER_IP=600
# PIC_RATE_LIMIT_PER_USER=1200
# PIC_OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
