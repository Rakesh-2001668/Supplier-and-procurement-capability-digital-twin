# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit real values.

# Neon PostgreSQL connection string (Neon Console → project → Connect).
# Use the direct (non-pooled) host for migrations/setup; the pooled "-pooler" host works for the API.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require

# Signing key for API access tokens. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
PIC_JWT_SECRET=

# Master key for field-level encryption (bank accounts, GSTIN, sealed bids). Generate:
# python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep it safe: data encrypted with it cannot be read without it.
PIC_FIELD_KEY=

# Password for the seeded demo users (…@axion.example). Leave empty to have one generated and shown once.
PIC_SEED_PASSWORD=

PIC_ENV=dev
