      "type": "string"
    },
    "scenarioId": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "round": {
      "type": "integer"
    },
    "reason": {
      "type": "string"
    },
    "overriddenBy": {
      "type": "string"
    },
    "overriddenAt": {
      "type": "string"
    },
    "bids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "supplier": {
            "type": "string"
          },
          "validUntil": {
            "type": "string"
          },
          "daysExpired": {
            "type": "integer"
          }
        },
        "required": [
          "supplier",
          "validUntil",
          "daysExpired"
        ]
      }
    },
    "annualValueMinor": {
      "type": "integer"
    }
  },
  "required": [
    "decisionId",
    "scenarioId",
    "category",
    "round",
    "reason",
    "overriddenBy",
    "overriddenAt",
    "bids",
