  { "op": "format", "field": "postingDate", "kind": "date", "pattern": "%Y%m%d" },
  { "op": "format", "field": "grossMinor", "kind": "minor_to_major", "decimals": 2 },
  { "op": "format", "field": "netMinor", "kind": "minor_to_major", "decimals": 2 },
  { "op": "format", "field": "taxMinor", "kind": "minor_to_major", "decimals": 2 },
  { "op": "lookup", "field": "gstRate", "table": {
